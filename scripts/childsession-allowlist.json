{
  "_comment": "Only actual Windows startup-entry process names are eligible for cleanup. Process names omit .exe. Use extraStartupProcesses only for startup apps Windows fails to expose through Win32_StartupCommand.",
  "initialDelaySeconds": 6,
  "cleanupSeconds": 45,
  "scanIntervalSeconds": 2,
  "allowProcesses": [
    "sunshine",
    "vibeshine",
    "explorer",
    "steam",
    "steamwebhelper",
    "GameOverlayUI",
    "SearchHost",
    "StartMenuExperienceHost",
    "ShellExperienceHost",
    "TextInputHost",
    "RuntimeBroker",
    "ApplicationFrameHost"
  ],
  "protectDescendantsOf": [
    "sunshine",
    "vibeshine",
    "steam"
  ],
  "extraStartupProcesses": [],
  "protectedPathPrefixes": [
    "%WINDIR%\\"
  ]
}
